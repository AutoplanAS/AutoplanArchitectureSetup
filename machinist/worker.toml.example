data_directory = "~/.machinist/worker"

[control_plane]
url = "http://127.0.0.1:7331"
token_file = "~/.machinist/server/worker.token"

[executors.codex]
command = [
  "codex",
  "exec",
  "--json",
  "--sandbox",
  "danger-full-access",
  "--model={{machinist.model}}",
  "-"
]
models = { luna = "gpt-5.6-luna", terra = "gpt-5.6-terra", sol = "gpt-5.6-sol" }

[repositories.autoplan-architecture-setup]
path = "/absolute/path/to/AutoplanArchitectureSetup"
